     5.2 Channel ROI Comparison

     Business Question: "Which support channels deliver the best return?"
     Why Unique: Helps prioritize channel investments

     -- Compare channel efficiency (volume per channel with assumed cost model)
     WITH channel_metrics AS (
       SELECT
         channel,
         SUM(support_inquiries) as total_volume,
         CASE channel
           WHEN 'chat' THEN 2.00  -- Live chat cost
           WHEN 'email' THEN 3.00  -- Email handling cost
           WHEN 'phone' THEN 8.00  -- Phone support cost
           WHEN 'help-center' THEN 0.10  -- Self-service cost
           WHEN 'contact_form' THEN 2.50
           ELSE 1.50  -- Social/other
         END as cost_per_inquiry
       FROM `growth-ops-recruiting.growth_marketing_recruiting.SupportInquiriesbyIntentandChannel`
       WHERE period >= DATE_SUB(CURRENT_DATE(), INTERVAL 30 DAY)
       GROUP BY channel
     )
     SELECT
       channel,
       total_volume,
       cost_per_inquiry,
       ROUND(total_volume * cost_per_inquiry, 0) as estimated_monthly_cost,
       ROUND(total_volume * 1.0 / (SELECT SUM(total_volume) FROM channel_metrics) * 100, 1) as volume_share_pct,
       ROUND(total_volume * cost_per_inquiry / (SELECT SUM(total_volume * cost_per_inquiry) FROM channel_metrics) * 100, 1) as cost_share_pct
     FROM channel_metrics
     ORDER BY estimated_monthly_cost DESC

