     | Quality  | Rate trend           | Merchant health scores  |

     KPI Cards for Header

     -- Single query to get all KPI summary values
     SELECT
       -- Automation Savings (YTD)
       (SELECT ROUND(SUM(
         CASE
           WHEN handling_type IN ('fully_resolved', 'flows_fully_resolved') THEN tickets * 4.50
           WHEN handling_type = 'ai_handover_to_human' THEN tickets * 1.50
           ELSE 0
         END
       ), 0) FROM `growth-ops-recruiting.growth_marketing_recruiting.MonthlyTicketHandlingEvolutionsince2024`
       WHERE EXTRACT(YEAR FROM month_start) = 2025) as ytd_savings,

       -- Current AI Resolution Rate
       (SELECT ROUND(success_rate_28 * 100, 1)
        FROM `growth-ops-recruiting.growth_marketing_recruiting.AIAgentResolutionrate`
        ORDER BY event_date DESC LIMIT 1) as current_resolution_rate,

       -- CSAT Risk Count (intents declining)
       (SELECT COUNT(*) FROM (
         SELECT contact_reason FROM `growth-ops-recruiting.growth_marketing_recruiting.AIAgentCSATbyTicketIntentRolling7Day`
         WHERE ticket_date >= DATE_SUB(CURRENT_DATE(), INTERVAL 7 DAY)
         GROUP BY contact_reason
         HAVING AVG(avg_score) < 4.0
       )) as csat_risk_count,

       -- GMV Influenced YTD
       (SELECT ROUND(SUM(gmv_influenced), 0)
        FROM `growth-ops-recruiting.growth_marketing_recruiting.TotalRevenueInfluencedandTotalGMVin2025`) as ytd_gmv_influenced,

       -- Merchants Needing Attention
       (SELECT COUNT(*) FROM `growth-ops-recruiting.growth_marketing_recruiting.GorgiasCustomersInteractionMetrics`
        WHERE automation_rate_percent < 20) as merchants_at_risk
