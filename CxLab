     4.2 GMV Band Performance Comparison

     Business Question: "Do larger merchants get better AI performance?"
     Why Unique: Identifies if we're serving all merchant sizes equally

     -- Compare AI performance across merchant tiers
     SELECT
       fixed_gmv_parent_band,
       COUNT(DISTINCT account_name) as merchant_count,
       SUM(rolling_total_tickets_28) as total_tickets,
       SUM(rolling_ai_covered_28) as ai_covered_tickets,
       ROUND(SAFE_DIVIDE(SUM(rolling_ai_covered_28), SUM(rolling_total_tickets_28)) * 100, 1) as resolution_rate,
       ROUND(SAFE_DIVIDE(SUM(rolling_closed_billed_28), SUM(rolling_total_tickets_28)) * 100, 1) as closure_rate,
       -- Is there a gap between small and large merchants?
       ROUND(SAFE_DIVIDE(SUM(rolling_ai_covered_28), SUM(rolling_total_tickets_28)) * 100, 1) -
         (SELECT ROUND(SAFE_DIVIDE(SUM(rolling_ai_covered_28), SUM(rolling_total_tickets_28)) * 100, 1)
          FROM `growth-ops-recruiting.growth_marketing_recruiting.AIAgentResolutionratebyMerchantsandGMV`
          WHERE event_date = (SELECT MAX(event_date) FROM `growth-ops-recruiting.growth_marketing_recruiting.AIAgentResolutionratebyMerchantsandGMV`)) as vs_overall_avg
     FROM `growth-ops-recruiting.growth_marketing_recruiting.AIAgentResolutionratebyMerchantsandGMV`
     WHERE event_date = (SELECT MAX(event_date) FROM `growth-ops-recruiting.growth_marketing_recruiting.AIAgentResolutionratebyMerchantsandGMV`)
