     Insight Category 3: AI TRAINING PRIORITIES

     3.1 AI Improvement Priority Matrix

     Business Question: "Where should we focus AI training for maximum impact?"
     Why Unique: Actionable prioritization, not just metrics

     -- Score intents by: High Volume + Low CSAT + High Handover = High Priority
     WITH intent_analysis AS (
       SELECT
         c.contact_reason,
         AVG(c.avg_score) as avg_csat,
         SUM(c.ticket_count) as total_volume,
         -- Normalize to 0-100 scale for scoring
         PERCENT_RANK() OVER (ORDER BY SUM(c.ticket_count)) * 100 as volume_percentile,
         PERCENT_RANK() OVER (ORDER BY AVG(c.avg_score) DESC) * 100 as csat_issue_percentile  -- Lower CSAT = higher score
       FROM `growth-ops-recruiting.growth_marketing_recruiting.AIAgentCSATbyTicketIntentRolling7Day` c
       WHERE c.ticket_date >= DATE_SUB(CURRENT_DATE(), INTERVAL 30 DAY)
       GROUP BY c.contact_reason
     )
     SELECT
       contact_reason,
       total_volume,
       ROUND(avg_csat, 2) as current_csat,
       ROUND(volume_percentile, 0) as volume_score,
       ROUND(csat_issue_percentile, 0) as improvement_need_score,
       ROUND((volume_percentile + csat_issue_percentile) / 2, 0) as priority_score,
       CASE
         WHEN (volume_percentile + csat_issue_percentile) / 2 >= 75 THEN 'P1 - Immediate Focus'
         WHEN (volume_percentile + csat_issue_percentile) / 2 >= 50 THEN 'P2 - High Priority'
         WHEN (volume_percentile + csat_issue_percentile) / 2 >= 25 THEN 'P3 - Monitor'
         ELSE 'P4 - Optimized'
       END as priority_tier
     FROM intent_analysis
     ORDER BY priority_score DESC

