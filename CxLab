     2.2 CSAT Early Warning System

     Business Question: "Which areas are trending toward poor satisfaction before it becomes a crisis?"
     Why Unique: Predictive alerts, not just historical reporting

     -- Identify intents with declining CSAT trend (potential problems brewing)
WITH csat_trends AS (
       SELECT
         contact_reason,
         ticket_date,
         avg_score,
         ticket_count,
         AVG(avg_score) OVER (PARTITION BY contact_reason ORDER BY ticket_date ROWS BETWEEN 13 PRECEDING AND 7 PRECEDING) as prev_week_avg,
         AVG(avg_score) OVER (PARTITION BY contact_reason ORDER BY ticket_date ROWS BETWEEN 6 PRECEDING AND CURRENT ROW) as current_week_avg
       FROM `growth-ops-recruiting.growth_marketing_recruiting.AIAgentCSATbyTicketIntentRolling7Day`
     )
     SELECT
       contact_reason,
       ROUND(AVG(current_week_avg), 2) as current_csat,
       ROUND(AVG(prev_week_avg), 2) as previous_csat,
       ROUND(AVG(current_week_avg) - AVG(prev_week_avg), 2) as csat_change,
       SUM(ticket_count) as volume,
       CASE
         WHEN AVG(current_week_avg) - AVG(prev_week_avg) < -0.2 THEN 'DECLINING - Action Needed'
         WHEN AVG(current_week_avg) - AVG(prev_week_avg) < -0.1 THEN 'Watch Closely'
         WHEN AVG(current_week_avg) - AVG(prev_week_avg) > 0.1 THEN 'Improving'
         ELSE 'Stable'
       END as trend_status
     FROM csat_trends
     WHERE ticket_date >= DATE_SUB(CURRENT_DATE(), INTERVAL 14 DAY)
     GROUP BY contact_reason
     HAVING SUM(ticket_count) > 100  -- Only significant volume
     ORDER BY csat_change ASC


