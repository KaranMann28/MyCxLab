     1.1 Automation Savings Calculator

     Business Question: "How much money is automation saving us?"
     Why Unique: Periscope shows volume, we show dollar impact

     -- Calculate cost savings from automation vs human handling
     -- Assumes: Human ticket = $5 avg cost, Automated = $0.50 avg cost
     WITH handling_costs AS (
       SELECT
         month_start,
         handling_type,
         tickets,
         CASE
           WHEN handling_type IN ('fully_resolved', 'flows_fully_resolved') THEN tickets * 0.50
           WHEN handling_type = 'ai_handover_to_human' THEN tickets * 3.50  -- partial automation
           ELSE tickets * 5.00  -- human_fully_resolved
         END as estimated_cost,
         tickets * 5.00 as if_all_human_cost  -- baseline comparison
       FROM `growth-ops-recruiting.growth_marketing_recruiting.MonthlyTicketHandlingEvolutionsince2024`
     )
     SELECT
       month_start,
       SUM(tickets) as total_tickets,
       ROUND(SUM(estimated_cost), 0) as actual_cost,
       ROUND(SUM(if_all_human_cost), 0) as if_human_cost,
       ROUND(SUM(if_all_human_cost) - SUM(estimated_cost), 0) as monthly_savings,
       ROUND((SUM(if_all_human_cost) - SUM(estimated_cost)) / SUM(if_all_human_cost) * 100, 1) as savings_percent
     FROM handling_costs
     GROUP BY month_start
     ORDER BY month_start

