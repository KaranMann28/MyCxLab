     Insight Category 2: PREDICTIVE & ANOMALY DETECTION

     2.1 Volume Anomaly Detector

     Business Question: "Are we seeing unusual ticket spikes that need attention?"
     Why Unique: Periscope shows history, we detect anomalies in real-time

     -- Detect months with unusual volume (>20% deviation from trend)
     WITH monthly_stats AS (
       SELECT
         month_start,
         tickets,
         AVG(tickets) OVER (ORDER BY month_start ROWS BETWEEN 3 PRECEDING AND 1 PRECEDING) as trailing_avg,
         STDDEV(tickets) OVER (ORDER BY month_start ROWS BETWEEN 6 PRECEDING AND 1 PRECEDING) as trailing_stddev
       FROM `growth-ops-recruiting.growth_marketing_recruiting.MonthlyTicketEvolutionsince2024`
     )
     SELECT
       month_start,
       tickets,
       ROUND(trailing_avg, 0) as expected_volume,
       ROUND((tickets - trailing_avg) / NULLIF(trailing_avg, 0) * 100, 1) as pct_deviation,
       CASE
         WHEN tickets > trailing_avg + 2 * trailing_stddev THEN 'SPIKE - Investigate'
         WHEN tickets < trailing_avg - 2 * trailing_stddev THEN 'DROP - Investigate'
         WHEN tickets > trailing_avg * 1.15 THEN 'Above Normal'
         WHEN tickets < trailing_avg * 0.85 THEN 'Below Normal'
         ELSE 'Normal'
       END as status
     FROM monthly_stats
     WHERE trailing_avg IS NOT NULL
     ORDER BY month_start

